# Copy to secret.yaml (git-ignored), fill in, and apply.
# Or: kubectl -n tfplan-system create secret generic terraform-viewer-secrets --from-literal=...
apiVersion: v1
kind: Secret
metadata:
  name: terraform-viewer-secrets
  namespace: tfplan-system
type: Opaque
stringData:
  # AWS credentials for S3 access
  AWS_ACCESS_KEY_ID: "CHANGE_ME"
  AWS_SECRET_ACCESS_KEY: "CHANGE_ME"
  # Jenkins API token
  JENKINS_TOKEN: "CHANGE_ME"
  # Django secret key
  DJANGO_SECRET_KEY: "CHANGE_ME"
