# Local development settings (python manage.py runserver). Never commit .env.
DJANGO_SECRET_KEY=CHANGE_ME
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
S3_BUCKET=example-terraform-plans
S3_REGION=us-west-2
JENKINS_URL=http://localhost:8080
JENKINS_USER=deploy
JENKINS_TOKEN=CHANGE_ME
JENKINS_JOB=homelab-terraform
# AWS credentials come from the normal boto3 chain (env, ~/.aws, instance role).
